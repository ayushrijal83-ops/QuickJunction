# Quick Junction -- environment template
#
# Copy to .env and fill in real values. .env is git-ignored and must NEVER
# be committed. This file contains placeholders only.
#
#   cp .env.example .env

# development | testing | production
APP_ENV=development

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-64-char-random-string

# MySQL DSN. Percent-encode any special characters in the password.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://qj_user:CHANGE_ME@127.0.0.1:3306/quick_junction

# Optional: overrides the in-memory SQLite database used by pytest.
# TEST_DATABASE_URL=mysql+pymysql://qj_user:CHANGE_ME@127.0.0.1:3306/quick_junction_test

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# Development server bind address (python run.py)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
