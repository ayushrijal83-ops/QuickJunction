# Quick Junction -- environment template
#
# Copy to .env and fill in real values. .env is git-ignored and must NEVER
# be committed. This file contains placeholders only.
#
#   cp .env.example .env

# development | testing | production
APP_ENV=development

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-64-char-random-string

# MySQL DSN. Percent-encode any special characters in the password.
# Use the dedicated application account (qj_user), never MySQL root: the app
# logs a warning for root in development and refuses to start in production.
# See docs/MYSQL_SETUP_HANDOFF.md section 5.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://qj_user:CHANGE_ME@127.0.0.1:3306/quick_junction

# Optional: overrides the in-memory SQLite database used by pytest.
# TEST_DATABASE_URL=mysql+pymysql://qj_user:CHANGE_ME@127.0.0.1:3306/quick_junction_test

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# Reverse proxies allowed to set X-Forwarded-For/-Proto/-Host. 0 (default)
# trusts none -- correct when nothing sits in front of the app. Set to 1
# behind a single Nginx that overwrites/appends those headers. Never higher
# than the real number of proxies. See docs/SECURITY.md section 18.
# TRUSTED_PROXY_COUNT=0

# Most upcoming CONFIRMED reservations one customer may hold (default 2).
# RESERVATION_ACTIVE_LIMIT=2

# Shared store for rate-limit counters. Leave unset for local development:
# the limiter then counts in the process's own memory. REQUIRED in
# production, where several workers must enforce one limit between them.
# Keep Redis on a private interface and never expose it to the restaurant
# LAN or the internet. Percent-encode special characters in the password.
#   redis://127.0.0.1:6379/0                        local, no password
#   redis://:CHANGE_ME@127.0.0.1:6379/0             password (requirepass)
#   redis://qj_limiter:CHANGE_ME@10.0.0.5:6379/0    ACL user
#   rediss://qj_limiter:CHANGE_ME@redis.internal:6380/0   TLS
#   unix:///run/redis/redis.sock?db=0               local socket
# See docs/SECURITY.md section 22.
# REDIS_URL=redis://127.0.0.1:6379/0

# Connect/read timeout for that store in milliseconds (default 200, 50-2000).
# When Redis does not answer in time the limiter falls back to in-memory
# counting instead of delaying the request.
# REDIS_SOCKET_TIMEOUT_MS=200

# Development server bind address (python run.py)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# --- local AI model -----------------------------------------------------
#
# These are the application's built-in defaults, repeated here so the layout
# is discoverable. Leave them commented out unless your models/ directory
# lives somewhere else -- the defaults below are already correct for the
# standard layout.
#
# The weights are roughly 1.4 GB and are deliberately NOT in Git (models/ is
# git-ignored). Cloning the repository does not install them; the models/
# directory must be copied across separately. See README.md section 9.
#
# Expected layout, relative to the repository root:
#
#   models/
#   |-- Qwen3-0.6B-Base/                     required
#   `-- qwen3-0.6b-quickjunction-lora-v4/    required (production adapter)
#
# IMPORTANT: if you set these, a relative path is resolved against the
# CURRENT WORKING DIRECTORY, not the repository root -- so it only works when
# the application is started from the repository root. Use an absolute path
# if you start it from anywhere else. Leaving them commented out avoids the
# problem entirely: the built-in defaults are absolute and derived from the
# repository location.
#
# Without the weights the application still runs; only the AI explanation
# shows as unavailable.

# Master switch for AI explanations (true | false). OFF unless set to true
# (M2): the model is optional and never loaded while disabled. Uncomment for
# local development or a demo; production must opt in deliberately after
# checking memory (one ~1.2 GB copy per worker) and docs/STATUS.md
# "Dependency audit".
# LLM_ENABLED=true

# Foundation model weights.
# LLM_MODEL_PATH=models/Qwen3-0.6B-Base

# Production LoRA adapter. v4 is the final selected model; v1-v3 exist only
# as historical artifacts and should not be used in production.
# LLM_ADAPTER_PATH=models/qwen3-0.6b-quickjunction-lora-v4

# Upper bound on generated tokens, which bounds explanation latency.
# LLM_MAX_NEW_TOKENS=48
