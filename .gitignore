# ---------------------------------------------------------------
# Database backups (M7.2) -- defense in depth: the default backup
# directory lives outside the repository already (see
# scripts/_backup_common.py DEFAULT_BACKUP_DIR), this only guards
# against QJ_BACKUP_DIR ever being pointed inside the repo by mistake,
# in any subdirectory, including with --no-encryption's plaintext .sql
# output. The pattern below matches only this tool's own backup file
# names (<database>_<YYYYMMDDTHHMMSSZ>.sql, see backup_database.py's
# `timestamp` / `stem`), not an unrelated hand-written .sql file such
# as a schema or fixture.
# ---------------------------------------------------------------
/backups/
*.sql.enc
*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.sql

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------
# Local LLM weights and caches (gigabytes -- root /models only,
# the leading slash keeps app/models/ tracked)
# ---------------------------------------------------------------
/models/
.cache/
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.onnx

# ---------------------------------------------------------------
# Fine-tuning / dataset artefacts (large, regenerable)
# ---------------------------------------------------------------
training/runs/
training/checkpoints/
training/outputs/
dataset/raw/
adapters/
*.npy
*.npz
*.pkl
*.joblib

# ---------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Local password list
PASSWORDS.txt

# Microsoft Office lock files (created while a document is open)
~$*
